/venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
/logs/
*.log

# Compiled Binaries (e.g., if a Go agent is compiled)
/bin/
/pkg/
/agent/quantum-agent

# OS and Editor Specific
.DS_Store
.idea/
.vscode/
*.swp
